<Window x:Class="SteamInventoryBoosterV2.Views.MainAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SteamInventoryBoosterV2.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Steam Inventory Booster" Height="800" Width="1200">

    <Window.DataContext>
        <Binding Source="{RelativeSource Self}" Path="ViewModel" />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#FF100F0F" Width="240">

            <StackPanel Orientation="Horizontal" Margin="0,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="AppIcon" Source="/Assets/AppImage.png" Width="120" Height="120"/>
            </StackPanel>

            <ListBox x:Name="NavigationMenu" 
            SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}" 
            Margin="0,30,0,0"
            Background="Transparent" 
            BorderThickness="0">

                <ListBoxItem Tag="SteamItemsPage" Foreground="White" FontSize="16" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎮" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Steam Items" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="InventoryManagementPage" Foreground="White" FontSize="16" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Inventory Management" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="BotManagerPage" Foreground="White" FontSize="16" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Bot Manager" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="SettingsPage" Foreground="White" FontSize="16" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </StackPanel>

        <Frame Content="{Binding CurrentPage}" Grid.Column="2" NavigationUIVisibility="Hidden" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
    </Grid>
</Window>
