<Page x:Class="SteamInventoryBoosterV2.Views.SteamItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SteamInventoryBoosterV2.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Steam Items Page">

    <Grid Grid.Row="0" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Add New Item" FontWeight="Bold" FontSize="16"/>
            <StackPanel Orientation="Horizontal" Margin="0,5" VerticalAlignment="Top">

                <StackPanel Width="300" Margin="0,0,10,0">
                    <TextBlock Text="Link" FontWeight="Bold"/>
                    <TextBox x:Name="TextBoxLink" Text="{Binding LinkInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Width="100" Margin="0,0,10,0">
                    <TextBlock Text="Buy Price" FontWeight="Bold"/>
                    <TextBox x:Name="TextBoxBuyPrice" Text="{Binding BuyPriceInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Width="100" Margin="0,0,10,0">
                    <TextBlock Text="Sell Price" FontWeight="Bold"/>
                    <TextBox x:Name="TextBoxSellPrice" Text="{Binding SellPriceInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Width="100" Margin="0,0,10,0">
                    <TextBlock Text="Profit" FontWeight="Bold"/>
                    <TextBox x:Name="TextBoxProfit" Text="{Binding ProfitInput, Mode=OneWay}" IsReadOnly="True" Background="LightGray"/>
                </StackPanel>

                <StackPanel Width="150">
                    <TextBlock Text="Profit Percentage" FontWeight="Bold"/>
                    <TextBox x:Name="TextBoxProfitPercentage" Text="{Binding ProfitPercentageInput, Mode=OneWay}" IsReadOnly="True" Background="LightGray"/>
                </StackPanel>

                <Button x:Name="AddButton" Content="Add" Command="{Binding AddItemCommand}" Width="100" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0">
                <StackPanel Width="300" Margin="0,0,10,0">
                    <TextBlock Text="Item Name" FontWeight="Bold" />
                    <TextBox x:Name="SearchTextBox" Text="{Binding SearchTermInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button x:Name="SearchButton" Content="Search" Command="{Binding SearchByNameCommand}" Width="100"/>
            </StackPanel>

            <Button x:Name="RefreshButton" Content="Refresh" Command="{Binding RefreshPageCommand}" HorizontalAlignment="Right" Width="100" Grid.Column="1"/>
        </Grid>

        <ListView Grid.Row="2" x:Name="ItemsListView" ItemsSource="{Binding FilteredSteamItensInformation}"  
          SelectedItem="{Binding SelectedItem}" Margin="10"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Icon"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding IconUrl}" Width="50" Height="50" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                    </Image.RenderTransform>
                                </Image>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="300" DisplayMemberBinding="{Binding Name}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Name" Command="{Binding SortCommand}" CommandParameter="ColumnName"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding BuyPrice, StringFormat='{}{0:F2}€'}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Buy Price" Command="{Binding SortCommand}" CommandParameter="ColumnBuyPrice"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding SellPrice, StringFormat='{}{0:F2}€'}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Sell Price" Command="{Binding SortCommand}" CommandParameter="ColumnSellPrice"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding SellProfit, StringFormat='{}{0:F2}€'}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Profit" Command="{Binding SortCommand}" CommandParameter="ColumnSellProfit"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding ProfitPercentage, StringFormat='{}{0:F2}%'}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Profit Percentage" Command="{Binding SortCommand}" CommandParameter="ColumnProfitPercentage"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding LastVerification, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Last Verification" Command="{Binding SortCommand}" CommandParameter="ColumnLastVerification"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding Price, StringFormat='{}{0:F2}€'}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Price" Command="{Binding SortCommand}" CommandParameter="ColumnPrice"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding HighestPurchaseOrder, StringFormat='{}{0:F2}€'}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Highest Purchase Order" Command="{Binding SortCommand}" CommandParameter="ColumnHighestPurchaseOrder"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Go to Page" Command="{Binding GoToPageCommand}" CommandParameter="{Binding SelectedItem}"/>
                    <MenuItem Header="Edit" Command="{Binding EditItemCommand}" CommandParameter="{Binding SelectedItem}"/>
                    <MenuItem Header="Update" Command="{Binding UpdateItemCommand}" CommandParameter="{Binding SelectedItem}"/>
                    <MenuItem Header="Remove" Command="{Binding RemoveItemCommand}" CommandParameter="{Binding SelectedItem}"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</Page>
